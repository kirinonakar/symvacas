{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SymvaCAS",
  "version": "1.6.8",
  "identifier": "com.kirinonakar.symvacas.windows",
  "build": {
    "beforeDevCommand": "python scripts/prepare.py",
    "beforeBuildCommand": "python scripts/prepare.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SymvaCAS",
        "width": 1500,
        "height": 900,
        "minWidth": 560,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://open.er-api.com https://api.frankfurter.app; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
