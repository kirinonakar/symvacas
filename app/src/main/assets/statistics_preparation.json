    {"key":"prefix","label":"Column prefix","type":"text","default":""},
    {"key":"duplicates","label":"Duplicate ID / variable pairs","type":"choice","default":"error","options":[["error","Error"],["first","First value"],["last","Last value"],["sum","Sum"],["mean","Mean"]]}
