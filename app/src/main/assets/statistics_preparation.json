  {"id":"dropMissing","label":"Delete rows / columns with missing values","fields":[
    {"key":"axis","label":"Delete from","type":"choice","default":"rows","options":[["rows","Delete rows"],["columns","Delete columns"]]},
    {"key":"rule","label":"Missing-value rule","type":"choice","default":"any","options":[["any","Any value is missing"],["all","All values are missing"]]}
  ]},
  {"id":"merge","label":"Combine datasets","fields":[
