    {"key":"axis","label":"Combine direction","type":"choice","default":"rows","options":[["rows","Append rows"],["columns","Append columns"]]},
    {"key":"rowAlignment","label":"Alignment","type":"choice","default":"header","options":[["header","Match column headers"],["position","Ignore headers (column order)"]],"when":{"axis":"rows"}},
    {"key":"columnAlignment","label":"Alignment","type":"choice","default":"position","options":[["index","Match index values"],["position","Ignore index (row order)"]],"when":{"axis":"columns"}},
    {"key":"leftHeader","label":"Current dataset header","type":"choice","default":"auto","options":[["auto","Auto-detect header"],["first","First row is a header"],["none","No header"]],"when":{"axis":"columns"}},
    {"key":"rightHeader","label":"Other dataset header","type":"choice","default":"auto","options":[["auto","Auto-detect header"],["first","First row is a header"],["none","No header"]],"when":{"axis":"columns"}},
    {"key":"leftIndex","label":"Current dataset index column","type":"column","default":"0","when":{"axis":"columns","columnAlignment":"index"}},
    {"key":"rightIndex","label":"Other dataset index column","type":"column","source":"dataset","default":"0","when":{"axis":"columns","columnAlignment":"index"}}
  ]},
  {"id":"wideToLong","label":"Wide → Long","fields":[
    {"key":"ids","label":"ID columns","type":"columns","default":"0"},
    {"key":"measures","label":"Measurement columns","type":"columns","default":"auto"},
    {"key":"variableHeader","label":"Variable column header","type":"text","default":"variable"},
    {"key":"valueHeader","label":"Value column header","type":"text","default":"value"},
    {"key":"rowHeader","label":"Automatic row ID header","type":"text","default":"row_id"}
