    {"key":"rules","label":"Value mappings (old value, new value per line)","type":"multiline","default":"","when":{"method":"exact"}},
    {"key":"cuts","label":"Numeric cut points","type":"text","default":"","when":{"method":"intervals"}},
    {"key":"groups","label":"Group values (comma-separated)","type":"text","default":"0,1","when":{"method":"intervals"}},
